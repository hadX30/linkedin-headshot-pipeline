# Copy to .env and fill in what you need. The pipeline's decision rules (thresholds,
# hard floors, composite weights, delivery bar, candidates) are in config.py, not here.

# ── Mode ──────────────────────────────────────────────────────────────────────
# live = real Claude + OpenAI calls (the default)
# mock = no API calls, fixtures + local stand-in image, for tests and demos (opt in explicitly)
HEADSHOT_MODE=live

# ── Models and generation (read by config.py) ─────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# IMAGE_MODEL=gpt-image-2.5-sunburst
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=medium
# OUTPUT_DIR=output                      # where pipeline.py writes its output files

# ── Trace store ───────────────────────────────────────────────────────────────
# sqlite (default when Supabase is not configured) or supabase
# TRACE_STORE=sqlite
# DATA_DIR=data
SUPABASE_URL=
SUPABASE_SECRET_KEY=             # sb_secret_... (or a legacy service_role key). Server only.
SUPABASE_DB_URL=                 # only for scripts/apply-migrations.sh: Connect -> Session pooler URI
# SUPABASE_SCHEMA=public
# SUPABASE_BUCKET=malameh-headshots

# ── API ───────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                     # required for /admin; use a long random value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://malameh-site(-[a-z0-9-]+)?\.vercel\.app   # also allow matching origins (Vercel previews)
# MAX_UPLOAD_MB=12
# RATE_LIMIT_PER_HOUR=20         # uploads per client IP per hour; 0 = off
# WORKERS=2

# ── Mock mode ─────────────────────────────────────────────────────────────────
# MOCK_SCENARIO=auto             # see: python -m headshot.cli scenarios
# MOCK_LATENCY_MS=700            # simulated time per call so the UI shows progress
