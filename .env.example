# Copy to .env and fill in what you need. Every setting has a safe default:
# with nothing set, the pipeline runs in mock mode (free, offline) with a local SQLite store.

# ── Mode ──────────────────────────────────────────────────────────────────────
# mock = fixtures + local stand-in image, no API calls, no cost (default)
# live = real Claude + OpenAI calls, billed. The admin dashboard can switch at runtime.
HEADSHOT_MODE=mock

# ── Live providers (only needed for live mode) ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=                 # low | medium | high; empty = model default
# CLAUDE_STRUCTURED_OUTPUTS=true # set false only for models without structured outputs
# IMAGE_MODEL=gpt-image-2.5-sunburst
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=medium           # low | medium | high
# IMAGE_INPUT_FIDELITY=high      # sent only to gpt-image-1 family models
# MAX_ATTEMPTS=3

# ── Trace store ───────────────────────────────────────────────────────────────
# sqlite (default when Supabase is not configured) or supabase
# TRACE_STORE=sqlite
# DATA_DIR=data
SUPABASE_URL=
SUPABASE_SECRET_KEY=             # sb_secret_... (or a legacy service_role key). Server only.
SUPABASE_DB_URL=                 # only for scripts/apply-migrations.sh: Connect -> Session pooler URI
# SUPABASE_SCHEMA=public
# SUPABASE_BUCKET=malameh-headshots

# ── API ───────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                     # required for /admin; use a long random value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://malameh-site(-[a-z0-9-]+)?\.vercel\.app   # also allow matching origins (Vercel previews)
# MAX_UPLOAD_MB=12
# RATE_LIMIT_PER_HOUR=20         # uploads per client IP per hour; 0 = off
# WORKERS=2

# ── Mock mode ─────────────────────────────────────────────────────────────────
# MOCK_SCENARIO=auto             # auto | deliver | retry_then_deliver | manual_review | exhausted | rejected | generation_retry | generation_error
# MOCK_LATENCY_MS=700            # simulated time per call so the UI shows progress
