# Copy to .env and fill in what you need. Every setting has a safe default:
# with nothing set, the pipeline runs in mock mode (free, offline) with a local SQLite store.

# ── Mode ──────────────────────────────────────────────────────────────────────
# live = real Claude + OpenAI calls (the default, as in the original pipeline)
# mock = no API calls, fixtures + local stand-in image, for tests and demos (opt in explicitly)
HEADSHOT_MODE=live

# ── Models (configuration only; the pipeline's logic does not depend on them) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5         # original: claude-sonnet-4-20250514 (deprecated)
# IMAGE_MODEL=gpt-image-2.5-sunburst     # original: gpt-image-1 (OpenAI shuts it down 2026-10-23)
# CLAUDE_EFFORT=                         # optional tuning for newer models; empty = model default

# ── Original pipeline constants ───────────────────────────────────────────────
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=medium
# MAX_RETRIES=3
# OUTPUT_DIR=output                      # where pipeline.py writes its output files

# ── Proposed behaviour changes: OFF until approved (docs/PROPOSED_CHANGES.md) ──
# REVIEW_FAIL_SAFE=false                 # P1: a missing review check counts as failed
# IMAGE_SEND_INPUT_FIDELITY=false        # P2: send input_fidelity (gpt-image-1 family)

# ── Trace store ───────────────────────────────────────────────────────────────
# sqlite (default when Supabase is not configured) or supabase
# TRACE_STORE=sqlite
# DATA_DIR=data
SUPABASE_URL=
SUPABASE_SECRET_KEY=             # sb_secret_... (or a legacy service_role key). Server only.
SUPABASE_DB_URL=                 # only for scripts/apply-migrations.sh: Connect -> Session pooler URI
# SUPABASE_SCHEMA=public
# SUPABASE_BUCKET=malameh-headshots

# ── API ───────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                     # required for /admin; use a long random value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://malameh-site(-[a-z0-9-]+)?\.vercel\.app   # also allow matching origins (Vercel previews)
# MAX_UPLOAD_MB=12
# RATE_LIMIT_PER_HOUR=20         # uploads per client IP per hour; 0 = off
# WORKERS=2

# ── Mock mode ─────────────────────────────────────────────────────────────────
# MOCK_SCENARIO=auto             # auto | deliver | retry_then_deliver | manual_review | exhausted | rejected | generation_retry | generation_error
# MOCK_LATENCY_MS=700            # simulated time per call so the UI shows progress
